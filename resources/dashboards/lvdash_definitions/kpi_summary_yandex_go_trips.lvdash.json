    {
      "name": "plus_subscriber_metrics",
      "displayName": "Plus Subscriber Penetration",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) AS total_users,\n",
        "  COUNT(\n",
        "    CASE\n",
        "      WHEN is_plus_subscriber = true THEN 1\n",
        "    END\n",
        "  ) AS plus_subscribers,\n",
        "  ROUND(\n",
        "    COUNT(\n",
        "      CASE\n",
        "        WHEN is_plus_subscriber = true THEN 1\n",
        "      END\n",
        "    )\n",
        "      * 100.0\n",
        "      / COUNT(*),\n",
        "    1\n",
        "  ) AS plus_penetration_pct\n",
        "FROM\n",
        "  yandex_go_prod.silver.users"
      ]
    }
