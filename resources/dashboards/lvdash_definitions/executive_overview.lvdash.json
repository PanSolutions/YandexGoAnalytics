{
  "datasets": [
    {
      "name": "kpi_summary",
      "displayName": "KPI Summary",
      "queryLines": [
        "SELECT ",
        "  COUNT(*) AS total_trips,",
        "  ROUND(SUM(fare_amount), 2) AS total_revenue,",
        "  COUNT(DISTINCT driver_id) AS active_drivers,",
        "  ROUND(AVG(driver_rating), 2) AS avg_driver_rating",
        "  FROM yandex_go_dev.gold.enriched_trips"
      ]
    },
    {
      "name": "trips_zones",
      "displayName": "Taxi Zones Revenue",
      "queryLines": [
        " SELECT pu_location_id, payment_type_description, total_trips, total_revenue",
        " FROM yandex_go_dev.gold.taxi_metrics",
        " ORDER BY total_revenue DESC"
      ]
    },
    {
      "name": "driver_experience",
      "displayName": "Driver Experience Analytics",
      "queryLines": [
        " SELECT experience, drivers_count, avg_rating",
        " FROM yandex_go_dev.gold.driver_metrics",
        " ORDER BY experience ASC"
      ]
    }
  ],
  "pages": [
    {
      "name": "executive_overview",
      "displayName": "Executive Overview",
      "layout": []
    }
  ]
}
