{
  "datasets": [
    {
      "name": "user_kpi_summary",
      "displayName": "User KPIs",
      "queryLines": [
        "  SELECT ",
        "  COUNT(*) AS total_users,",
        "  COUNT(CASE WHEN is_plus_subscriber = true THEN 1 END) AS plus_subscribers,",
        "  ROUND(COUNT(CASE WHEN is_plus_subscriber = true THEN 1 END) * 100.0 / COUNT(*), 1) AS plus_penetration_pct",
        "  FROM yandex_go_dev.silver.users"
      ]
    },
    {
      "name": "daily_registrations",
      "displayName": "Daily Registrations Trend",
      "queryLines": [
        "  SELECT registration_date, users_count",
        "  FROM yandex_go_dev.gold.user_metrics",
        "  ORDER BY registration_date ASC"
      ]
    }
  ],
  "pages": [
    {
      "name": "user_overview_page",
      "displayName": "User Growth & Cohorts",
      "layout": []
    }
  ]
}
